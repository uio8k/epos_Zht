# 构建产物
*.o
# 歌曲 WAV：由 tools/prepare_song.py 从 MP3 生成（18MB 级，随 Makefile mcopy 进 hd.img，不进 git）
samples/song*.wav
*.map
*.dep
kernel/eposkrnl.*
kernel/kernel.ld
userapp/a.out
userapp/.testmode_*
hd.img
hd.vmdk
# 工具二进制
tools/**/*.exe
# 评测输出报告（baseline_report.json 是基线，保留）
tools/eval_report.json
# 无头运行与验收产物
userapp/serial.log
out_*.wav
tools/audio_trace.log
__pycache__/

# 宿主侧单测产物（tests/build 由 run_tests.bat 生成）
tests/build/
