variant edits applied:
  terminal    : P11 data-done 0 -> 1                       (expect TERMINAL, exit 0)
  blocked     : P11 data-dep P10 -> P13 (P13 is optional)   (expect BLOCKED,  exit 0)
  baddep      : P11 data-dep P10 -> P99 (unknown id)        (expect exit 1)
  selfdep     : P11 data-dep P10 -> P11 (itself)            (expect exit 1)
  cycle       : P11 dep P13, P13 dep P11                    (expect exit 1, cycle path)
  optdone     : P13 data-done 0 -> 1 while data-optional=1  (expect exit 1)
  missingdone : P11 loses data-done attribute               (expect exit 1)
  dupid       : P13 data-id P13 -> P11 (duplicate id)       (expect exit 1)
  baddone     : P11 data-done 0 -> 2 (invalid value)        (expect exit 1)

